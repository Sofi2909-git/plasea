# Copiar a .env y completar. El archivo .env NO se sube al repositorio.

# --- Aplicacion ---
ENTORNO=desarrollo
CLAVE_SECRETA=cambiar-por-un-valor-largo-y-aleatorio
# Con localhost, los enlaces de correo solo abren en el computador del equipo.
URL_BASE_ENLACES=http://localhost:5000

# --- Base de datos (MariaDB en XAMPP, utf8mb4) ---
URL_BASE_DATOS=mysql+pymysql://usuario:clave@localhost:3306/plasea?charset=utf8mb4

# --- Correo ---
# Desarrollo: Mailpit (captor local). Demostracion: Gmail con contrasena de aplicacion.
CORREO_SERVIDOR=localhost
CORREO_PUERTO=1025
CORREO_USA_TLS=false
CORREO_USUARIO=
CORREO_CLAVE_APLICACION=
CORREO_REMITENTE=plasea@localhost
